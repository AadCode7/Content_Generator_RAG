# Groq API key: create one at https://console.groq.com/keys
GROQ_API_KEY=

# Model ID must be enabled for your Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# Application limits
DATABASE_PATH=data/gta_researcher.db
REQUEST_TIMEOUT_SECONDS=20
MAX_ARTICLES_PER_SOURCE=8
MAX_ARTICLE_CHARS=12000
MIN_ARTICLE_CHARS=180

# Live clipper (only use sources you own or are explicitly authorised to record)
TWITCH_USERNAME=
TWITCH_OAUTH_TOKEN=
LIVE_VIDEO_URL=
